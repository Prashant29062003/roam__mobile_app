# The Clerk publishable key. Public by design: it ships in the app bundle.
# Pull it with `npx clerk@latest env pull`, or copy it from the Dashboard.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The Clerk secret key. Server-side only: never prefix it with EXPO_PUBLIC_,
# never read it in app code, and never commit it.
CLERK_SECRET_KEY=
